SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=product-images

# Port for the local/Render web process.
PORT=3000

# Secret used to sign browser sign-in tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, tokens live in this process's memory only, so sign-ins break on
# restart and on serverless hosts where each request may reach a new instance.
# Keep it private and use the same value across every instance of one deployment.
# SESSION_SECRET=replace-with-a-64-character-hex-secret

# Comma-separated origins allowed to call /api/* from a browser when the
# storefront is hosted on a different origin than this server (for example
# GitHub Pages serving public/ while the API runs elsewhere).
# Leave empty for same-origin deployments; it is the safest default.
# Use * only for throwaway testing, never in production.
# CORS_ALLOWED_ORIGINS=https://yourname.github.io,https://yourstore.store
